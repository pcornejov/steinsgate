---
import { formatYearRange, label } from '../lib/data';
import { url } from '../lib/site';
import type { Media } from '../lib/types';

interface Props {
  item: Media;
  /** Muestra la puntuación de AniList cuando existe. */
  showScore?: boolean;
}

const { item, showScore = true } = Astro.props;
const accent = item.accentColor ?? '#ff9d2f';
---

<a
  href={url(`/obras/${item.slug}`)}
  class="group relative flex flex-col overflow-hidden border border-line bg-panel transition-colors duration-300 hover:border-nixie/55"
>
  <div class="relative aspect-[2/3] overflow-hidden bg-abyss">
    {
      item.cover ? (
        <img
          src={url(item.cover)}
          alt={`Portada de ${item.title.display}`}
          width="460"
          height="690"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      ) : (
        <div class="grid h-full w-full place-items-center font-mono text-xs text-ink-mute">
          sin portada
        </div>
      )
    }

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void via-void/25 to-transparent opacity-85"
    >
    </div>

    <span
      class="absolute top-2 left-2 border border-white/15 bg-void/80 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-ink-soft uppercase backdrop-blur-sm"
    >
      {label.format(item.format)}
    </span>

    {
      showScore && item.averageScore && (
        <span
          class="absolute top-2 right-2 border bg-void/80 px-1.5 py-0.5 font-mono text-[10px] font-bold backdrop-blur-sm"
          style={`border-color:${accent}66;color:${accent}`}
        >
          {item.averageScore}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-1 p-3">
    <h3
      class="font-display text-[15px] leading-tight font-semibold text-ink transition-colors group-hover:text-nixie"
    >
      {item.title.display}
    </h3>
    <p class="font-mono text-[11px] text-ink-mute">
      {formatYearRange(item)}
      {item.episodes ? ` · ${item.episodes} ep.` : ''}
      {item.chapters ? ` · ${item.chapters} cap.` : ''}
    </p>
  </div>

  <span
    class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"
    style={`background:${accent}`}
    aria-hidden="true"></span>
</a>
