---
import type { GetStaticPaths } from 'astro';

import Prose from '../../components/Prose.astro';
import Spoiler from '../../components/Spoiler.astro';
import Base from '../../layouts/Base.astro';
import { getProfile } from '../../content/profiles';
import {
  characters,
  formatBirthday,
  formatNumber,
  getMedia,
  label,
  metaSummary,
} from '../../lib/data';
import { url } from '../../lib/site';

export const getStaticPaths = (() =>
  characters.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }))) satisfies GetStaticPaths;

const { character } = Astro.props;
const profile = getProfile(character.id);

const appearances = character.appearsIn
  .map((id) => getMedia(id))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .sort((a, b) => (a.startDate ?? '').localeCompare(b.startDate ?? ''));

const facts: [string, string][] = [
  ...(character.name.native ? ([['Nombre original', character.name.native]] as [string, string][]) : []),
  ['Rol', character.role === 'MAIN' ? 'Principal' : 'Secundario'],
  ...(character.age ? ([['Edad', `${character.age} años`]] as [string, string][]) : []),
  ...(formatBirthday(character.birthday)
    ? ([['Cumpleaños', formatBirthday(character.birthday)!]] as [string, string][])
    : []),
  ...(character.bloodType ? ([['Grupo sanguíneo', character.bloodType]] as [string, string][]) : []),
  ['Apariciones', `${appearances.length} obras`],
  ['Favoritos', formatNumber(character.favourites)],
];

// `metaSummary` devuelve '' cuando el texto de la fuente falta o es demasiado
// corto, de modo que el fallback propio entra y ninguna ficha queda sin description.
const description =
  profile?.tagline ||
  metaSummary(character.description) ||
  `${character.name.full} en la enciclopedia de Steins;Gate: datos del personaje, ` +
    `seiyuu y obras de la franquicia en las que aparece.`;
---

<Base title={character.name.full} description={description} image={character.image}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <nav aria-label="Ruta" class="font-mono text-[11px] tracking-wide text-ink-mute">
      <a href={url('/personajes')} class="transition-colors hover:text-gel">Personajes</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-ink-soft">{character.role === 'MAIN' ? 'Principal' : 'Secundario'}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[300px_1fr] lg:gap-14">
      {/* ─────────────  Columna del retrato  ───────────── */}
      <div class="lg:sticky lg:top-24 lg:self-start">
        {
          character.image && (
            <img
              src={url(character.image)}
              alt={`Retrato de ${character.name.full}`}
              width="380"
              height="507"
              class="w-full border border-line object-cover"
              fetchpriority="high"
            />
          )
        }

        <div class="lab-panel mt-5 p-5">
          <h2 class="eyebrow">Datos</h2>
          <dl class="mt-4 space-y-3">
            {
              facts.map(([term, value]) => (
                <div class="flex justify-between gap-3 border-b border-line/40 pb-2.5 last:border-0 last:pb-0">
                  <dt class="shrink-0 font-mono text-[11px] tracking-wide text-ink-mute uppercase">
                    {term}
                  </dt>
                  <dd class="text-right text-[13px] font-medium text-ink">{value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        {
          character.voiceActors.length > 0 && (
            <div class="lab-panel mt-5 p-5">
              <h2 class="eyebrow">Voz</h2>
              <ul class="mt-4 space-y-3">
                {character.voiceActors.map((va) => (
                  <li class="flex items-center gap-3">
                    {va.image && (
                      <img
                        src={url(va.image)}
                        alt=""
                        width="44"
                        height="44"
                        loading="lazy"
                        class="h-11 w-11 shrink-0 border border-line object-cover"
                      />
                    )}
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-ink">{va.name}</p>
                      {va.native && (
                        <p class="truncate font-mono text-[11px] text-ink-mute">{va.native}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      {/* ─────────────  Columna del perfil  ───────────── */}
      <div class="min-w-0">
        <h1 class="font-display text-4xl leading-tight font-bold text-ink sm:text-5xl">
          {character.name.full}
        </h1>

        {
          profile?.alias && (
            <p class="mt-2 font-mono text-[13px] tracking-wide text-nixie">{profile.alias}</p>
          )
        }

        {
          profile?.tagline && (
            <p class="mt-5 border-l-2 border-gel/50 pl-4 text-lg leading-relaxed text-ink italic">
              {profile.tagline}
            </p>
          )
        }

        {
          profile?.traits && profile.traits.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {profile.traits.map((trait) => (
                <li class="border border-line bg-panel px-2.5 py-1 font-mono text-[11px] text-ink-soft">
                  {trait}
                </li>
              ))}
            </ul>
          )
        }

        {
          profile?.bio && (
            <section class="mt-9">
              <h2 class="font-display text-xl font-bold text-ink">Perfil</h2>
              <Prose class="mt-4" text={profile.bio} />
              {profile.spoilerNote && (
                <p class="mt-5 border border-alert/30 bg-alert/[0.05] px-3 py-2 font-mono text-[11px] text-alert/90">
                  Aviso: {profile.spoilerNote}
                </p>
              )}
            </section>
          )
        }

        {
          character.name.alternative.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display text-xl font-bold text-ink">Otros nombres</h2>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {character.name.alternative.slice(0, 12).map((alt) => (
                  <li class="border border-line/70 px-2 py-0.5 font-mono text-[11px] text-ink-mute">
                    {alt}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          character.description && (
            <section class="mt-10">
              <h2 class="font-display text-xl font-bold text-ink">Ficha de la fuente</h2>
              <p class="mt-1 font-mono text-[11px] text-ink-mute">
                Descripción tal y como la publica AniList, en inglés y sin editar.
              </p>
              <Spoiler class="mt-4" label="Puede contener spoilers">
                <Prose text={character.description} size="sm" />
              </Spoiler>
            </section>
          )
        }

        {
          appearances.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display text-xl font-bold text-ink">Aparece en</h2>
              <ul class="mt-4 divide-y divide-line/50 border border-line">
                {appearances.map((item) => (
                  <li>
                    <a
                      href={url(`/obras/${item.slug}`)}
                      class="group flex items-center gap-3 bg-panel/50 px-3 py-2.5 transition-colors hover:bg-panel"
                    >
                      {item.cover && (
                        <img
                          src={url(item.cover)}
                          alt=""
                          width="40"
                          height="58"
                          loading="lazy"
                          class="h-14 w-10 shrink-0 border border-line object-cover"
                        />
                      )}
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium text-ink transition-colors group-hover:text-nixie">
                          {item.title.display}
                        </p>
                        <p class="mt-0.5 font-mono text-[11px] text-ink-mute">
                          {label.format(item.format)}
                          {item.startDate ? ` · ${item.startDate.slice(0, 4)}` : ''}
                        </p>
                      </div>
                      <span
                        class="shrink-0 text-ink-mute transition-colors group-hover:text-nixie"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Base>
