---
import type { GetStaticPaths } from 'astro';

import Spoiler from '../../components/Spoiler.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, getEpisodes, label, mediaWithEpisodes } from '../../lib/data';
import { url } from '../../lib/site';

export const getStaticPaths = (() =>
  mediaWithEpisodes.map((item) => ({
    params: { slug: item.slug },
    props: { item, episodes: getEpisodes(item.id) },
  }))) satisfies GetStaticPaths;

const { item, episodes } = Astro.props;
const accent = item.accentColor ?? '#ff9d2f';
const totalRuntime = episodes.reduce((sum, episode) => sum + (episode.runtime ?? 0), 0);
---

<Base
  title={`Episodios de ${item.title.display}`}
  description={`Guía de los ${episodes.length} episodios de ${item.title.display}: sinopsis, fecha de emisión y duración.`}
  image={item.banner ?? item.cover}
  bare
>
  <header class="relative overflow-hidden border-b border-line/60">
    {
      item.banner && (
        <div class="absolute inset-0" aria-hidden="true">
          <img src={url(item.banner)} alt="" class="h-full w-full object-cover opacity-20" />
          <div class="absolute inset-0 bg-gradient-to-t from-void via-void/90 to-void/60" />
        </div>
      )
    }

    <div class="relative mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <nav aria-label="Ruta" class="font-mono text-[11px] tracking-wide text-ink-mute">
        <a href={url('/episodios')} class="transition-colors hover:text-nixie">Episodios</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <a href={url(`/obras/${item.slug}`)} class="transition-colors hover:text-nixie">
          {item.title.display}
        </a>
      </nav>

      <h1 class="mt-5 font-display text-3xl leading-tight font-bold text-ink sm:text-4xl lg:text-5xl">
        {item.title.display}
      </h1>

      <p class="mt-3 font-mono text-sm text-ink-soft">
        {label.format(item.format)} · {episodes.length}
        {episodes.length === 1 ? ' episodio' : ' episodios'}
        {totalRuntime > 0 ? ` · ${Math.round(totalRuntime / 60)} h ${totalRuntime % 60} min en total` : ''}
      </p>
    </div>

    <div class="h-px" style={`background:linear-gradient(90deg,transparent,${accent},transparent)`}></div>
  </header>

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <p class="mb-8 border border-line bg-panel/50 px-4 py-3 text-sm text-ink-soft">
      Las sinopsis proceden de Kitsu y describen los acontecimientos del episodio.
      Están ocultas por defecto: pulsa para desplegarlas.
    </p>

    <ol class="space-y-4">
      {
        episodes.map((episode) => (
          <li id={`ep-${episode.number}`} class="lab-panel scroll-mt-24 overflow-hidden">
            <div class="flex flex-col gap-4 p-4 sm:flex-row sm:p-5">
              {episode.thumbnail && (
                <img
                  src={url(episode.thumbnail)}
                  alt={`Fotograma del episodio ${episode.number}`}
                  width="240"
                  height="135"
                  loading="lazy"
                  class="w-full shrink-0 border border-line object-cover sm:w-52"
                />
              )}

              <div class="min-w-0 flex-1">
                <div class="flex items-baseline gap-3">
                  <span class="nixie-text font-mono text-2xl font-bold">
                    {String(episode.number).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <h2 class="font-display text-lg leading-tight font-semibold text-ink">
                      {episode.title}
                    </h2>
                    {episode.titleJa && (
                      <p class="mt-0.5 font-mono text-[11px] text-ink-mute">{episode.titleJa}</p>
                    )}
                  </div>
                </div>

                <p class="mt-2.5 font-mono text-[11px] tracking-wide text-ink-mute uppercase">
                  {formatDate(episode.airdate)}
                  {episode.runtime ? ` · ${episode.runtime} min` : ''}
                </p>

                {episode.synopsis && (
                  <Spoiler class="mt-4" label="Sinopsis del episodio">
                    <p class="text-[13.5px] leading-relaxed text-ink-soft">{episode.synopsis}</p>
                  </Spoiler>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
