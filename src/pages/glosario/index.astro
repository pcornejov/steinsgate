---
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { glossary, glossaryByCategory } from '../../content/glossary';
import { url } from '../../lib/site';
import type { GlossaryEntry } from '../../lib/types';

const categories = Object.entries(glossaryByCategory) as [GlossaryEntry['category'], string][];

const grouped = categories
  .map(([id, title]) => ({
    id,
    title,
    entries: glossary
      .filter((entry) => entry.category === id)
      .sort((a, b) => a.term.localeCompare(b.term, 'es')),
  }))
  .filter((group) => group.entries.length > 0);
---

<Base
  title="Glosario"
  description="Glosario de Steins;Gate: D-Mail, Reading Steiner, campos atractores, SERN, IBN 5100 y el resto de la terminología de la obra."
>
  <PageHeader
    eyebrow={`${glossary.length} entradas`}
    title="Glosario"
    lead="La terminología de la obra explicada: los conceptos que sostienen su modelo del tiempo, los artefactos que lo hacen posible y las organizaciones que lo persiguen. Las entradas que revelan el desenlace están marcadas."
  >
    <nav aria-label="Categorías del glosario" class="mt-8 flex flex-wrap gap-2">
      {
        grouped.map((group) => (
          <a
            href={`#${group.id}`}
            class="border border-line bg-panel px-3 py-1.5 font-mono text-[11px] tracking-wide text-ink-soft uppercase transition-colors hover:border-gel/50 hover:text-gel"
          >
            {group.title}
            <span class="ml-1.5 text-ink-mute">{group.entries.length}</span>
          </a>
        ))
      }
    </nav>
  </PageHeader>

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    {
      grouped.map((group) => (
        <section id={group.id} class="mb-14 scroll-mt-24 last:mb-0">
          <h2 class="border-b border-line/60 pb-3 font-display text-2xl font-bold text-ink">
            {group.title}
          </h2>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {group.entries.map((entry) => (
              <a
                href={url(`/glosario/${entry.slug}`)}
                class="group lab-panel flex flex-col p-5 transition-colors hover:border-gel/50"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="font-display text-lg leading-tight font-semibold text-ink transition-colors group-hover:text-gel">
                      {entry.term}
                    </h3>
                    {entry.reading && (
                      <p class="mt-0.5 font-mono text-[11px] text-ink-mute">{entry.reading}</p>
                    )}
                  </div>
                  {entry.spoiler && (
                    <span class="shrink-0 border border-alert/40 px-1.5 py-0.5 font-mono text-[9px] tracking-wider text-alert uppercase">
                      Spoiler
                    </span>
                  )}
                </div>
                <p class="mt-3 text-[13.5px] leading-relaxed text-ink-soft">{entry.short}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
