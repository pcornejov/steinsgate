---
import type { GetStaticPaths } from 'astro';

import CharacterCard from '../../components/CharacterCard.astro';
import Prose from '../../components/Prose.astro';
import Spoiler from '../../components/Spoiler.astro';
import Base from '../../layouts/Base.astro';
import {
  charactersOf,
  formatDate,
  formatNumber,
  getEpisodes,
  getMedia,
  label,
  media,
  metaSummary,
  staffOf,
} from '../../lib/data';
import { url } from '../../lib/site';

export const getStaticPaths = (() =>
  media.map((item) => ({ params: { slug: item.slug }, props: { item } }))) satisfies GetStaticPaths;

const { item } = Astro.props;

const cast = charactersOf(item.id);
const crew = staffOf(item.id);
const episodes = getEpisodes(item.id);
const accent = item.accentColor ?? '#ff9d2f';

const related = item.relations
  .map((relation) => ({ relation, target: getMedia(relation.id) }))
  .filter((entry): entry is { relation: typeof entry.relation; target: NonNullable<typeof entry.target> } =>
    Boolean(entry.target),
  );

// Ficha técnica: sólo mostramos las filas con dato real.
const facts: [string, string][] = [
  ['Formato', label.format(item.format)],
  ['Estado', label.status(item.status)],
  ['Estreno', formatDate(item.startDate)],
  ...(item.endDate && item.endDate !== item.startDate
    ? ([['Final', formatDate(item.endDate)]] as [string, string][])
    : []),
  ...(item.episodes ? ([['Episodios', String(item.episodes)]] as [string, string][]) : []),
  ...(item.duration ? ([['Duración', `${item.duration} min`]] as [string, string][]) : []),
  ...(item.chapters ? ([['Capítulos', String(item.chapters)]] as [string, string][]) : []),
  ...(item.volumes ? ([['Volúmenes', String(item.volumes)]] as [string, string][]) : []),
  ...(item.studios.length ? ([['Estudio', item.studios.join(', ')]] as [string, string][]) : []),
  ['Origen', label.source(item.source)],
  ...(item.averageScore
    ? ([['Puntuación', `${item.averageScore}/100`]] as [string, string][])
    : []),
  ...(item.favourites ? ([['Favoritos', formatNumber(item.favourites)]] as [string, string][]) : []),
];
---

<Base
  title={item.title.display}
  description={metaSummary(item.description) ||
    `${item.title.display}: ficha completa en la enciclopedia de Steins;Gate con datos de ` +
      `producción, reparto y relación con el resto del catálogo.`}
  image={item.banner ?? item.cover}
  bare
>
  {/* ─────────────  Cabecera  ───────────── */}
  <header class="relative overflow-hidden border-b border-line/60">
    {
      item.banner && (
        <div class="absolute inset-0" aria-hidden="true">
          <img src={url(item.banner)} alt="" class="h-full w-full object-cover opacity-20" />
          <div class="absolute inset-0 bg-gradient-to-t from-void via-void/90 to-void/60" />
        </div>
      )
    }

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <nav aria-label="Ruta" class="font-mono text-[11px] tracking-wide text-ink-mute">
        <a href={url('/obras')} class="transition-colors hover:text-nixie">Obras</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <span class="text-ink-soft">{label.format(item.format)}</span>
      </nav>

      <div class="mt-6 grid gap-8 sm:grid-cols-[190px_1fr] sm:gap-10">
        {
          item.cover && (
            <img
              src={url(item.cover)}
              alt={`Portada de ${item.title.display}`}
              width="460"
              height="690"
              class="w-40 border border-line sm:w-full"
              fetchpriority="high"
            />
          )
        }

        <div class="min-w-0">
          <h1 class="font-display text-3xl leading-tight font-bold text-ink sm:text-4xl lg:text-5xl">
            {item.title.display}
          </h1>

          <div class="mt-2 space-y-0.5 font-mono text-[13px] text-ink-mute">
            {item.title.romaji && item.title.romaji !== item.title.display && (
              <p>{item.title.romaji}</p>
            )}
            {item.title.native && <p>{item.title.native}</p>}
          </div>

          {item.genres.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {item.genres.map((genre) => (
                <li class="border border-line bg-panel px-2 py-0.5 font-mono text-[11px] text-ink-soft">
                  {label.genre(genre)}
                </li>
              ))}
            </ul>
          )}

          <div class="mt-6 flex flex-wrap gap-3">
            {episodes.length > 0 && (
              <a
                href={url(`/episodios/${item.slug}`)}
                class="clip-hud bg-nixie px-5 py-2.5 font-display text-[13px] font-bold tracking-wide text-void uppercase transition-colors hover:bg-nixie-glow"
              >
                Guía de {episodes.length} episodios
              </a>
            )}
            <a
              href={item.siteUrl}
              rel="noopener noreferrer external"
              target="_blank"
              class="clip-hud border border-line px-5 py-2.5 font-display text-[13px] font-bold tracking-wide text-ink-soft uppercase transition-colors hover:border-gel/50 hover:text-gel"
            >
              Ver en AniList
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="h-px" style={`background:linear-gradient(90deg,transparent,${accent},transparent)`}></div>
  </header>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_300px] lg:gap-12">
    {/* ─────────────  Columna principal  ───────────── */}
    <div class="min-w-0">
      {
        item.description && (
          <section>
            <h2 class="font-display text-xl font-bold text-ink">Sinopsis</h2>
            <p class="mt-1 font-mono text-[11px] text-ink-mute">
              Reproducida tal y como la publica AniList, en inglés y sin editar.
            </p>
            <Spoiler class="mt-4" label="La sinopsis de la fuente puede adelantar acontecimientos">
              <Prose text={item.description} size="sm" />
            </Spoiler>
          </section>
        )
      }

      {
        item.trailer && (
          <section class="mt-12">
            <h2 class="font-display text-xl font-bold text-ink">Tráiler</h2>
            <div class="mt-4 aspect-video w-full border border-line bg-abyss">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${item.trailer.youtubeId}`}
                title={`Tráiler de ${item.title.display}`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      {
        episodes.length > 0 && (
          <section class="mt-12">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <h2 class="font-display text-xl font-bold text-ink">Episodios</h2>
              <a
                href={url(`/episodios/${item.slug}`)}
                class="font-display text-[13px] font-bold tracking-wide text-gel uppercase transition-colors hover:text-ink"
              >
                Guía completa →
              </a>
            </div>

            <ol class="mt-4 divide-y divide-line/50 border border-line">
              {episodes.slice(0, 6).map((episode) => (
                <li class="flex gap-3 bg-panel/50 px-3 py-2.5">
                  <span class="nixie-text w-8 shrink-0 pt-0.5 text-right font-mono text-sm font-bold">
                    {String(episode.number).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-ink">{episode.title}</p>
                    {episode.airdate && (
                      <p class="mt-0.5 font-mono text-[11px] text-ink-mute">
                        {formatDate(episode.airdate)}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        cast.length > 0 && (
          <section class="mt-12">
            <h2 class="font-display text-xl font-bold text-ink">Reparto</h2>
            <p class="mt-1 text-sm text-ink-soft">{cast.length} personajes acreditados en esta obra.</p>
            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {cast.slice(0, 12).map((character) => (
                <CharacterCard character={character} />
              ))}
            </div>
            {cast.length > 12 && (
              <a
                href={url('/personajes')}
                class="mt-5 inline-block font-display text-[13px] font-bold tracking-wide text-gel uppercase transition-colors hover:text-ink"
              >
                Ver los {cast.length} personajes →
              </a>
            )}
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="mt-12">
            <h2 class="font-display text-xl font-bold text-ink">Obras relacionadas</h2>
            <ul class="mt-4 divide-y divide-line/50 border border-line">
              {related.map(({ relation, target }) => (
                <li>
                  <a
                    href={url(`/obras/${target.slug}`)}
                    class="group flex items-center gap-3 bg-panel/50 px-3 py-2.5 transition-colors hover:bg-panel"
                  >
                    {target.cover && (
                      <img
                        src={url(target.cover)}
                        alt=""
                        width="46"
                        height="66"
                        loading="lazy"
                        class="h-14 w-10 shrink-0 border border-line object-cover"
                      />
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-medium text-ink transition-colors group-hover:text-nixie">
                        {target.title.display}
                      </p>
                      <p class="mt-0.5 font-mono text-[11px] text-ink-mute">
                        {label.relation(relation.relationType)} · {label.format(target.format)}
                      </p>
                    </div>
                    <span class="shrink-0 text-ink-mute transition-colors group-hover:text-nixie" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {/* ─────────────  Barra lateral  ───────────── */}
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="lab-panel p-5">
        <h2 class="eyebrow">Ficha técnica</h2>
        <dl class="mt-4 space-y-3">
          {
            facts.map(([term, value]) => (
              <div class="flex justify-between gap-3 border-b border-line/40 pb-2.5 last:border-0 last:pb-0">
                <dt class="shrink-0 font-mono text-[11px] tracking-wide text-ink-mute uppercase">
                  {term}
                </dt>
                <dd class="text-right text-[13px] font-medium text-ink">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        crew.length > 0 && (
          <div class="lab-panel mt-5 p-5">
            <h2 class="eyebrow">Equipo</h2>
            <ul class="mt-4 space-y-3">
              {crew.slice(0, 8).map((person) => (
                <li class="flex items-center gap-2.5">
                  {person.image && (
                    <img
                      src={url(person.image)}
                      alt=""
                      width="34"
                      height="34"
                      loading="lazy"
                      class="h-8 w-8 shrink-0 border border-line object-cover"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="truncate text-[13px] font-medium text-ink">{person.name}</p>
                    <p class="truncate font-mono text-[10px] text-ink-mute">
                      {label.staffRole(person.roles[0])}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        item.synonyms.length > 0 && (
          <div class="lab-panel mt-5 p-5">
            <h2 class="eyebrow">También conocida como</h2>
            <ul class="mt-3 space-y-1.5 text-[13px] text-ink-soft">
              {item.synonyms.slice(0, 6).map((synonym) => (
                <li>{synonym}</li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</Base>
