---
import MediaCard from '../../components/MediaCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { anime, manga, meta } from '../../lib/data';

// Agrupamos por naturaleza de la obra en vez de por formato bruto de la API.
const groups = [
  {
    id: 'anime',
    title: 'Animación',
    lead: 'Series, película, OVAs y ONAs.',
    items: anime,
  },
  {
    id: 'manga',
    title: 'Manga y novelas',
    lead: 'Adaptaciones e historias paralelas en papel, incluidas las derivaciones cómicas.',
    items: manga,
  },
];
---

<Base
  title="Obras"
  description={`Catálogo completo de las ${meta.counts.media} obras de Steins;Gate: anime, manga y novelas ligeras, con fichas detalladas.`}
>
  <PageHeader
    eyebrow={`${meta.counts.media} entradas catalogadas`}
    title="Las obras"
    lead="Todo lo que la franquicia ha producido en animación y papel, desde la serie de 2011 hasta las derivaciones más marginales. Cada ficha reúne datos de producción, relaciones con el resto del catálogo y, cuando existe, guía de episodios."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    {
      groups.map((group) => (
        <section id={group.id} class="mb-16 scroll-mt-24 last:mb-0">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line/60 pb-3">
            <h2 class="font-display text-2xl font-bold text-ink">{group.title}</h2>
            <span class="font-mono text-xs text-ink-mute">{group.items.length} obras</span>
          </div>
          <p class="mt-3 text-sm text-ink-soft">{group.lead}</p>

          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {group.items.map((item) => (
              <MediaCard item={item} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
