---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { isActive, nav, site, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Imagen de portada para Open Graph (ruta ya prefijada con /media/...). */
  image?: string | null;
  /** Oculta el borde superior degradado en portadas con héroe propio. */
  bare?: boolean;
}

const { title, description = site.description, image = null, bare = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.tagline}`;
const currentPath = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImage = image ? new URL(url(image), Astro.site ?? 'https://example.com').href : null;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={site.lang} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#05060a" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-mono-src" />
    <Font cssVariable="--font-sans-src" preload />
  </head>

  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-nixie focus:text-void focus:px-4 focus:py-2 focus:font-mono focus:text-sm"
    >
      Saltar al contenido
    </a>

    <header class="sticky top-0 z-50 border-b border-line/70 bg-void/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
        <a href={url('/')} class="group flex shrink-0 items-center gap-2.5">
          <span
            class="grid h-9 w-9 place-items-center border border-nixie/50 bg-nixie/10 font-mono text-[13px] font-bold text-nixie transition-colors group-hover:bg-nixie/20"
            aria-hidden="true">SG</span
          >
          <span class="hidden leading-none sm:block">
            <span class="block font-display text-[15px] font-bold tracking-wide text-ink">
              {site.title}
            </span>
            <span class="mt-0.5 block font-mono text-[10px] tracking-[0.18em] text-ink-mute uppercase">
              {site.tagline}
            </span>
          </span>
        </a>

        <nav aria-label="Principal" class="ml-auto min-w-0">
          <ul class="flex items-center gap-0.5 overflow-x-auto text-[13px] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {
              nav.map((item) => {
                const active = isActive(currentPath, item.href);
                return (
                  <li class="shrink-0">
                    <a
                      href={url(item.href)}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'block whitespace-nowrap px-2.5 py-1.5 font-display font-semibold tracking-wide transition-colors sm:px-3',
                        active ? 'text-nixie' : 'text-ink-soft hover:text-ink',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
      {!bare && <div class="h-px bg-gradient-to-r from-transparent via-nixie/45 to-transparent" />}
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line/70 bg-abyss/60">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="lg:col-span-2">
            <p class="font-display text-lg font-bold text-ink">{site.title}</p>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">
              Enciclopedia no oficial de <em>Steins;Gate</em>, construida como sitio estático.
              Los datos objetivos y las imágenes provienen de APIs públicas; los textos
              enciclopédicos son originales de este proyecto.
            </p>
          </div>

          <div>
            <p class="eyebrow">Secciones</p>
            <ul class="mt-3 space-y-1.5 text-sm">
              {
                nav.slice(1).map((item) => (
                  <li>
                    <a href={url(item.href)} class="text-ink-soft transition-colors hover:text-nixie">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="eyebrow">Fuentes de datos</p>
            <ul class="mt-3 space-y-1.5 text-sm">
              <li>
                <a
                  href="https://anilist.co"
                  rel="noopener noreferrer external"
                  target="_blank"
                  class="text-ink-soft transition-colors hover:text-gel">AniList</a
                >
              </li>
              <li>
                <a
                  href="https://kitsu.app"
                  rel="noopener noreferrer external"
                  target="_blank"
                  class="text-ink-soft transition-colors hover:text-gel">Kitsu</a
                >
              </li>
              <li>
                <a href={url('/creditos')} class="text-ink-soft transition-colors hover:text-gel">
                  Créditos y método
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="mt-8 flex flex-col gap-2 border-t border-line/60 pt-6 font-mono text-[11px] text-ink-mute sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {year} — proyecto de fans, sin ánimo de lucro.</p>
          <p>
            <span class="text-nixie">El Psy Kongroo.</span> Steins;Gate es propiedad de 5pb. / Nitroplus.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
